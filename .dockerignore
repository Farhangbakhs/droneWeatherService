# ============================================
# Docker Ignore File
# ============================================
# Excludes files and directories from Docker build context
# Reduces image size and build time
# ============================================

# Maven build output
target/
!target/Cw1-1.0.0.jar

# Maven wrapper (copied explicitly in Dockerfile)
# Comment out if you want to exclude wrapper
# .mvn/
# mvnw
# mvnw.cmd

# IDE files
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
.DS_Store

# Git files
.git/
.gitignore
.gitattributes

# CI/CD files
.github/
.gitlab-ci.yml
.travis.yml
azure-pipelines.yml

# Documentation (not needed in container)
*.md
!README.md
docs/
documentation/
CLAUDE.md
Cw3MD.md
FINAL_STATUS.md
IMPLEMENTATION_SUMMARY.md
QUICK_START.md
START_DEMO.md
TESTING_MODE_*.md
TEST_CASES_CATALOG.md
projectv*.md

# Frontend (separate deployment)
frontend/
node_modules/

# Test files (not needed in production image)
src/test/

# Docker files (don't include Docker files in Docker build)
Dockerfile*
docker-compose*.yml
.dockerignore

# Log files
*.log
logs/

# Temporary files
tmp/
temp/
*.tmp

# OS files
Thumbs.db
desktop.ini

# Environment files (secrets should be passed at runtime)
.env
.env.*
*.properties.local

# PDF files
*.pdf

# Null file (Windows artifact)
nul

# Backup files
*.bak
*.backup
*.old
