# ============================================
# Environment Variables for Docker Deployment
# ============================================
# IMPORTANT: Replace 'your_api_key_here' with your actual OpenWeatherMap API key
# Get your free API key from: https://openweathermap.org/api
# ============================================

# Weather API Key (REQUIRED)
WEATHER_API_KEY=your_api_key_here

# Optional: Override default endpoints
# ILP_ENDPOINT=https://ilp-rest-2025-bvh6e9hschfagrgy.ukwest-01.azurewebsites.net/
# WEATHER_API_ENDPOINT=https://api.openweathermap.org/

# Optional: Grafana admin password (if using monitoring)
# GRAFANA_PASSWORD=secure_password_here

# Optional: JVM tuning
# JAVA_OPTS=-Xms512m -Xmx1024m -XX:+UseG1GC

# Optional: Spring profiles
# SPRING_PROFILES_ACTIVE=production
